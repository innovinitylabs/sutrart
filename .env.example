# Copy to app/.env.local for local development
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional portable signed listing feed URL for server-side syndication
NEXT_PUBLIC_SIGNED_LISTING_FEED_URL=

# Local Anvil flow (default chain is anvil / 31337)
# 1. pnpm contracts:anvil
# 2. pnpm contracts:deploy:local
# 3. pnpm dev

# Sepolia deployment (contracts/.env or repo root .env)
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
