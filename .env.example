# Copy to app/.env.local for local development
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default chain for SSR + wallet initial chain (31337 = Anvil, 11155111 = Sepolia, 84532 = Base Sepolia)
NEXT_PUBLIC_DEFAULT_CHAIN_ID=31337

# Optional portable signed listing feed URL for server-side syndication
NEXT_PUBLIC_SIGNED_LISTING_FEED_URL=

# Local Anvil flow
# 1. pnpm contracts:anvil
# 2. pnpm contracts:deploy:local
# 3. pnpm dev

# Sepolia alpha deployment (repo root .env or contracts/.env)
SEPOLIA_RPC_URL=
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Base Sepolia test deployment (repo root .env or contracts/.env)
BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Mainnet (future production — omit from wallet until set; viem default blocks browser CORS)
MAINNET_RPC_URL=
NEXT_PUBLIC_MAINNET_RPC_URL=

DEPLOYER_PRIVATE_KEY=

# Server-side vars are used by SSR reads; NEXT_PUBLIC_* vars are baked into the client bundle for wallet RPC.
# Set NEXT_PUBLIC_SEPOLIA_RPC_URL and NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL on Vercel for production.

# After Sepolia deploy, switch the app to Sepolia:
# NEXT_PUBLIC_DEFAULT_CHAIN_ID=11155111

# After Base Sepolia deploy, switch the app to Base Sepolia:
# NEXT_PUBLIC_DEFAULT_CHAIN_ID=84532
