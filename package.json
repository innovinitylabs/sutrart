{
  "name": "pari",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @pari/app dev",
    "build": "pnpm --filter @pari/shared --filter @pari/abi --filter @pari/sdk run build && pnpm --filter @pari/app run build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:build": "pnpm --filter @pari/contracts build && pnpm --filter @pari/abi abi:sync",
    "contracts:test": "pnpm --filter @pari/contracts test",
    "contracts:fmt": "pnpm --filter @pari/contracts fmt",
    "contracts:anvil": "pnpm --filter @pari/contracts anvil",
    "contracts:deploy:local": "pnpm contracts:build && pnpm --filter @pari/contracts deploy:local",
    "contracts:deploy:sepolia": "pnpm contracts:build && pnpm --filter @pari/contracts deploy:sepolia",
    "manifest:validate": "node scripts/validate-deployment-manifest.mjs packages/shared/src/deployments/sepolia.json",
    "manifest:validate:local": "node scripts/validate-deployment-manifest.mjs packages/shared/src/deployments/local.json",
    "validate:sepolia": "pnpm --filter @pari/shared --filter @pari/abi --filter @pari/sdk run build && pnpm --filter @pari/sdk validate:sepolia",
    "sdk:test": "pnpm --filter @pari/sdk test"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  }
}
